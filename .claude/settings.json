{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/Library/Application Support/Google/DriveFS",
        "./private/client_secret*.json",
        "./private/token*.json"
      ],
      "denyWrite": [
        "~/Library/CloudStorage",
        "./private/client_secret*.json",
        "./private/token*.json",
        "./private/*.journal.jsonl",
        "./private/*.journal.jsonl.undo.jsonl",
        "./gdrive_organizer",
        "./.venv",
        "./scripts",
        "./.git/hooks",
        "./.git/config",
        "./pyproject.toml",
        "./private/config.json",
        "./private/*.sqlite",
        "./private/*.sqlite-journal",
        "./private/*.sqlite-wal",
        "./private/*.sqlite-shm",
        "./tests",
        "./examples",
        "./.claude",
        "./.mcp.json",
        "./*.py",
        "./*.pth"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(//Users/*/Library/CloudStorage/**)",
      "Edit(//Users/*/Library/CloudStorage/**)",
      "Read(./private/client_secret*.json)",
      "Read(./private/token*.json)",
      "Read(./private/quarantine.txt)",
      "Read(./.private-patterns)"
    ]
  }
}
